# Supabase — copy to .env.local and fill in from your project's API settings.
# Safe to expose to the browser (anon/publishable key is RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# The public key is exposed to the browser; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
